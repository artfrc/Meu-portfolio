# Copie este arquivo para .env e preencha com seus valores.
# .env fica fora do git (veja .gitignore) — nunca commite tokens reais.

# Token do bot, gerado pelo @BotFather no Telegram (comando /newbot ou /mybots).
PORTFOLIO_TELEGRAM_BOT_TOKEN=

# Chat id de quem deve receber o push. Envie uma mensagem pro bot e depois
# acesse https://api.telegram.org/bot<TOKEN>/getUpdates para descobrir o valor.
PORTFOLIO_TELEGRAM_CHAT_ID=

# Opcional: sobrescreve a API key padrao de dev usada no GET /api/contact.
# PORTFOLIO_ADMIN_KEY=
